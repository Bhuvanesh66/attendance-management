PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Clerk (same app as frontend; publishable key is required for API auth)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional: JWT iat vs server clock tolerance (default 60000). Increase if you see session-token-iat-in-the-future.
# CLERK_CLOCK_SKEW_IN_MS=60000

# Must include every frontend origin that sends session tokens (JWT `azp`). Add production URLs when you deploy.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://your-app.vercel.app

# Comma-separated list of allowed browser origins for CORS (e.g. Vercel URL + localhost)
CORS_ORIGINS=http://localhost:5173

